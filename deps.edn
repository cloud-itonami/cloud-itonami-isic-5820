{:paths ["src"]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/crm
        {:local/root "../../kotoba-lang/crm"}
        ;; Explicit top-level :local/root (NOT left to :dev's override-
        ;; deps alone): langgraph's own deps.edn pins langchain to a git
        ;; SHA, and tools.deps resolves the SHALLOWEST declaration for a
        ;; given lib -- crm.kotobase (src/crm/kotobase.cljk) needs
        ;; langchain.kotoba-db's live fixes (this session's :q/:pull/
        ;; :entid wire-format corrections), so a plain `kbb -M:serve`
        ;; (no :dev) must not silently fall back to the stale git-pinned
        ;; copy. Confirmed this was happening, 2026-07-18: `kbb -M
        ;; <script requiring crm.kotobase>` without :dev loaded the old
        ;; kotoba_db.cljc (a println added directly inside its :pull impl
        ;; never printed), even though the local `orgs/kotoba-lang/
        ;; langchain` checkout already had the fix.
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        ;; HTTP service layer (src/crm/http.cljk, JVM-only compat glue —
        ;; see its ns docstring for why this is not a .cljc violation).
        http-kit/http-kit        {:mvn/version "2.8.1"}
        ring/ring-core           {:mvn/version "1.15.3"}
        org.clojure/data.json    {:mvn/version "2.5.2"}
        ;; kotobase.net Store backend (src/crm/kotobase.cljk): self-sovereign
        ;; CACAO mint (this actor's own Ed25519 key, never a handed token) —
        ;; same pattern as com-etzhayyim-tsumugu's tsumugu.cacao/tsumugu.kotoba
        ;; (CLAUDE.md "kotoba-server (kotobase.net) = actor が自分の鍵で CACAO
        ;; を自己発行"). :local/root during monorepo dev, git dep for a clean
        ;; clone (mirrors org-chainagnostic-cacao's own :local vs default split).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:local/root "../../kotoba-lang/org-chainagnostic-cacao"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:local/root "../../kotoba-lang/org-ietf-ed25519"}
        io.github.kotoba-lang/org-ietf-cbor
        {:local/root "../../kotoba-lang/org-ietf-cbor"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :run {:main-opts ["-m" "crm.sim"]}
  ;; kbb -M:serve → starts the real HTTP service (src/crm/http.cljk).
  ;; Port: $ISIC5820_HTTP_PORT (default 8080). Auth: $ISIC5820_API_TOKEN
  ;; MUST be set (fail-closed — see docs/api.md).
  :serve {:main-opts ["-m" "crm.http"]}
  ;; kbb -M:dev:render-html → build-time regenerate docs/samples/
  ;; operator-console.html through the real CRM actor (crm.render-html,
  ;; driving crm.operation/crm.policy/crm.store the same way crm.sim does).
  ;; Closes flagship checklist item 2 (ADR-2607189300). :dev needed for the
  ;; sibling langchain override (same as -M:dev:serve).
  :render-html {:main-opts ["-m" "crm.render-html"]}
  ;; kbb -M:dev:dogfood-seed <path> → write the cloud-itonami own-funnel
  ;; dogfood snapshot to the ISIC5820_STORE_FILE (reproducible re-seed for
  ;; the live deploy, ADR-2607199950). Format matches crm.file-store/persist!.
  :dogfood-seed {:main-opts ["-m" "crm.dogfood-seed"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
